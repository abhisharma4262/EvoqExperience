    "remotion:render:home": "remotion render remotion/index.ts HomeFilm out/videos/HomeFilm.mp4",
    "remotion:render:create": "remotion render remotion/index.ts CreateLaunch out/videos/CreateLaunch.mp4",
    "remotion:render:transform": "remotion render remotion/index.ts TransformLaunch out/videos/TransformLaunch.mp4",
    "remotion:render:operate": "remotion render remotion/index.ts OperateLaunch out/videos/OperateLaunch.mp4"
  },
  "dependencies": {
