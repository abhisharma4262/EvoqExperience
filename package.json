    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@remotion/bundler": "^4.0.507",
    "@remotion/cli": "^4.0.507",
    "@remotion/player": "^4.0.507",
    "@remotion/renderer": "^4.0.507",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.84.0",
